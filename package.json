{
  "name": "network-desk",
  "version": "1.2.12",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "start": "node server/index.mjs --open",
    "test": "node --test tests/*.test.mjs",
    "test:live": "node scripts/smoke-live.mjs",
    "package": "node scripts/package.mjs",
    "check:release": "node scripts/release-check.mjs",
    "desktop": "electron .",
    "desktop:assets": "node scripts/desktop-assets.mjs",
    "desktop:pack": "npm run check:release && npm run build && npm run desktop:assets && electron-builder --config electron-builder.json --win portable --x64 && node scripts/wrap-portable.mjs",
    "desktop:dir": "npm run check:release && npm run build && npm run desktop:assets && electron-builder --config electron-builder.json --dir --win --x64"
  },
  "description": "Independent local network and environment diagnostics with Chinese reports",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "rimraf": "file:./scripts/temp-cleanup-compat",
    "@resvg/resvg-js": "2.6.2",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "fflate": "0.8.3",
    "prettier": "3.6.2",
    "@vitejs/plugin-react": "5.0.4",
    "bootstrap-icons": "1.13.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.5"
  },
  "overrides": {
    "@electron/asar": "4.3.1",
    "@electron/universal": "3.0.6",
    "ejs": "5.0.2",
    "glob": "14.0.3",
    "minimatch": "11.0.3",
    "temp@0.9.4": {
      "rimraf": "$rimraf"
    }
  },
  "main": "desktop/main.cjs",
  "author": "Network Desk contributors"
}
